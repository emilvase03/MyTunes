<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="255.0" prefWidth="375.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mytunes.GUI.Controllers.EditSongViewController">
    <children>
        <VBox alignment="CENTER_RIGHT" layoutX="8.0" layoutY="28.0" prefHeight="171.0" prefWidth="46.0" spacing="20.0">
            <children>
                <Label text="Title:" />
                <Label text="Artist:" />
                <Label text="Genre:" />
                <Label text="Time:" />
                <Label text="File:" />
            </children>
        </VBox>
        <TextField fx:id="txtTitleEdit" layoutX="70.0" layoutY="26.0" prefHeight="26.0" prefWidth="222.0" />
        <TextField fx:id="txtArtistEdit" layoutX="70.0" layoutY="63.0" prefHeight="26.0" prefWidth="222.0" />
        <TextField fx:id="txtTimeEdit" layoutX="70.0" layoutY="139.0" prefHeight="26.0" prefWidth="72.0" />
        <TextField fx:id="txtFilePathEdit" layoutX="70.0" layoutY="176.0" prefHeight="26.0" prefWidth="222.0" promptText="Path" />
        <Button layoutX="304.0" layoutY="176.0" mnemonicParsing="false" onAction="#onBtnChooseEdit" text="Choose" />
        <Button layoutX="304.0" layoutY="213.0" mnemonicParsing="false" onAction="#onBtnSaveEdit" prefHeight="26.0" prefWidth="56.0" text="Save" />
        <Button layoutX="240.0" layoutY="213.0" mnemonicParsing="false" onAction="#onBtnCancelEdit" text="Cancel" />
        <TextField fx:id="txtGenreEdit" layoutX="70.0" layoutY="100.0" prefHeight="26.0" prefWidth="222.0" />
      <Text layoutX="158.0" layoutY="19.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Edit" />
    </children>
</AnchorPane>
