<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="rootPane" prefHeight="275.0" prefWidth="440.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mytunes.GUI.Controllers.LoginViewController">
    <children>
        <Text layoutX="92.0" layoutY="76.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome To MyTunes">
            <font>
                <Font size="26.0" />
            </font>
        </Text>
        <Text layoutX="159.0" layoutY="116.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Please login to enter" />
        <TextField fx:id="txtUsername" alignment="CENTER" layoutX="145.0" layoutY="138.0" promptText="Username" />
        <TextField fx:id="txtPassword" alignment="CENTER" layoutX="146.0" layoutY="171.0" promptText="Password" />
        <Button layoutX="190.0" layoutY="208.0" mnemonicParsing="false" onAction="#onBtnLoginClick" text="Login" />
        <Text layoutX="165.0" layoutY="257.0" onMouseClicked="#onTxtRegisterClick" strokeType="OUTSIDE" strokeWidth="0.0" text="Need an account?" />
    </children>
</AnchorPane>
