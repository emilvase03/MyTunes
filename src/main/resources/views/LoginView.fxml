<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="rootPane" prefHeight="275.0" prefWidth="440.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mytunes.GUI.Controllers.LoginViewController">
    <children>
        <Text fx:id="lblWelcome" layoutX="102.0" layoutY="76.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome To MyTunes">
            <font>
                <Font size="26.0" />
            </font>
        </Text>
        <Text fx:id="loginText" layoutX="162.0" layoutY="116.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Please login to enter" />
        <TextField fx:id="txtUsername" alignment="CENTER" layoutX="145.0" layoutY="138.0" promptText="Username" />
        <PasswordField fx:id="txtPassword" alignment="CENTER" layoutX="146.0" layoutY="171.0" onKeyPressed="#onEnterLogin" promptText="Password" />
        <Button fx:id="logInButton" alignment="CENTER" contentDisplay="CENTER" layoutX="194.0" layoutY="206.0" mnemonicParsing="false" onAction="#onBtnLoginClick" text="Login" />
        <Text fx:id="needAccounteTxt" layoutX="176.0" layoutY="258.0" onMouseClicked="#onTxtRegisterClick" strokeType="OUTSIDE" strokeWidth="0.0" text="Need an account?" />
    </children>
</AnchorPane>
